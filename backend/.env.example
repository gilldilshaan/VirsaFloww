# Application Configuration
APP_NAME="TerraLedger AI Backend"
APP_ENV=development
APP_MODE=demo
PORT=8000
HOST=0.0.0.0

# Storage Engine (json | postgres; default: json)
# Set to 'postgres' to use Supabase PostgreSQL + PostGIS persistence layer
STORAGE_BACKEND=json

# PostgreSQL Database Connections (Supabase Session Pooler)
# IMPORTANT:
# 1. Use the Session Pooler on port 5432 (e.g. aws-0-<region>.pooler.supabase.com:5432).
#    NEVER use transaction pooler port 6543 (incompatible with prepared statements and row locking).
# 2. Driver scheme: postgresql+psycopg
# 3. Require SSL: sslmode=require
# 4. Never commit real passwords or connection strings to source control.
DATABASE_URL=postgresql+psycopg://postgres.<prod-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
TEST_DATABASE_URL=postgresql+psycopg://postgres.<test-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# CORS Configuration
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Authentication (Sprint-grade Dev Auth - NOT PRODUCTION READY)
JWT_SECRET=your_jwt_secret_min_32_chars_placeholder
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
PASSWORD_SALT=your_demo_salt_placeholder

# Demo User Seeding (REQUIRED for user seeding/reseed; no default fallback permitted)
DEMO_USER_PASSWORD=your_demo_password_here

# Storage Paths
DATA_DIR=backend/data
RUNTIME_DIR=backend/data/runtime
UPLOAD_DIR=backend/data/uploads
AUDIT_LOG_PATH=backend/data/audit/audit.jsonl
SEED_DIR=backend/data/seed
ROOT_SEED_EVIDENCE_PATH=data/seed_evidence.json
ROOT_SEED_MARKETPLACE_PATH=data/marketplace_seed.json
LEAD_OBSERVATIONS_PATH=data/observations.json

# Upload Policy
MAX_UPLOAD_SIZE_BYTES=15728640
